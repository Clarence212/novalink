[Unit]
Description=Create and verify a NovaLink database backup
After=mariadb.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/novalink/backup.env
ExecStart=/usr/bin/bash /var/www/html/novalink/backend/scripts/backup_database.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/novalink
